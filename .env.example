# Copy to `.env` at the repo root and fill in locally. Do not commit `.env`.

# SQLAI cache / Postgres URL (Neon or self-hosted)
CACHE_DB_URL=

# LLM used by SQLAI, AskGraph and the migration pipelines.
# Any OpenAI-compatible chat endpoint; defaults to NVIDIA's hosted API.
NVIDIA_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b
AI_TIMEOUT_SECONDS=120

# AskGraph extras (served at /askgraph by SQLAI/app2.py); see AskGraph/.env.example.
# SAMPLE_DB_URL=                # database behind the "Use sample database" button
# SCHEMA_CACHE_TTL_HOURS=24

# Example for migrations / docs
MONGO_URL=
