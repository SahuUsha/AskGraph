# --- LLM (any OpenAI-compatible endpoint; NVIDIA by default) ---
# REQUIRED.
NVIDIA_API_KEY=
LLM_BASE_URL=https://integrate.api.nvidia.com/v1
LLM_MODEL=nvidia/nemotron-3-super-120b-a12b

# --- Database Connection URLs ---
# REQUIRED. No default — a committed fallback is a committed password.
CACHE_DB_URL=postgresql://user:password@host:port/dbname?sslmode=require

# --- Limits (optional; defaults shown) ---
MAX_PAGE_SIZE=1000
SCHEMA_CACHE_TTL_HOURS=24
DB_CONNECT_TIMEOUT=10
AI_TIMEOUT_SECONDS=120

# --- Sample demo database (optional) ---
# Behind the UI's "Use sample database" button (sent as preset:sample) and
# used by scripts/sample_db.py.
SAMPLE_DB_URL=postgresql://user:password@host:5432/neondb?sslmode=require
